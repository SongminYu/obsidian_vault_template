properties:
  created:
    displayName: Created
  file.name:
    displayName: Filename
  topics:
    displayName: Topics
views:
  - type: table
    name: All
    filters:
      and:
        - list(categories).contains(link(this.file.path))
        - '!file.path.contains("templates/")'
    order:
      - created
      - file.name
      - topics
    sort:
      - property: created
        direction: DESC
    columnSize:
      file.name: 311
