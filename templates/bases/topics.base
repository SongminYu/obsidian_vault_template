properties:
  created:
    displayName: Created
  file.name:
    displayName: Filename
  categories:
    displayName: Categories
views:
  - type: table
    name: All
    filters:
      and:
        - list(topics).contains(link(this.file.path))
        - '!file.path.contains("templates/")'
    order:
      - created
      - file.name
      - categories
    sort:
      - property: created
        direction: DESC
    columnSize:
      file.name: 379
