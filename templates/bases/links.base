properties:
  created:
    displayName: Created
  file.name:
    displayName: Filename
  categories:
    displayName: Categories
views:
  - type: table
    name: Backlinks
    filters:
      and:
        - file.hasLink(this)
        - '!file.path.contains("templates/")'
        - "!list(topics).contains(link(this.file.path))"
        - "!list(categories).contains(link(this.file.path))"
    order:
      - created
      - file.name
      - categories
    sort:
      - property: created
        direction: DESC
    columnSize:
      file.name: 376
